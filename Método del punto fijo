        "# ==========================================\n",
        "# Método de punto fijo\n",
        "# Ejemplo 1 — Algoritmo de Burden\n",
        "# Resolución de x^3 + 4x^2 - 10 = 0\n",
        "# =========================================="
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt"
      ],
      "metadata": {
        "id": "W6Mj7tCE9utP"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def f(x):\n",
        "    return x**3 + 4*x**2 - 10\n",
        "\n",
        "def g(x):\n",
        "    return (10.0 / (4.0 + x))**0.5"
      ],
      "metadata": {
        "id": "kh-70tB891nm"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def iteracion_punto_fijo(x0, tol=1e-5, max_iter=100):\n",
        "    historial = []\n",
        "    x_curr = x0\n",
        "\n",
        "    for k in range(1, max_iter + 1):\n",
        "        x_next = g(x_curr)\n",
        "        error = abs(x_next - x_curr)\n",
        "\n",
        "        historial.append({\n",
        "            'iter': k,\n",
        "            'p_n': x_next,\n",
        "            'f_pn': f(x_next),\n",
        "            'error': error\n",
        "        })\n",
        "\n",
        "        if error < tol:\n",
        "            return x_next, historial, True\n",
        "\n",
        "        x_curr = x_next\n",
        "\n",
        "    return x_curr, historial, False"
      ],
      "metadata": {
        "id": "xGUA7agx94Vv"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "p0 = 1.5\n",
        "tolerancia = 1e-5\n",
        "limite_iter = 100\n",
        "\n",
        "solucion, pasos, exito = iteracion_punto_fijo(p0, tolerancia, limite_iter)\n",
        "\n",
        "header = f\"{'n':>3} | {'p_n':>14} | {'f(p_n)':>12} | {'Error abs':>12}\"\n",
        "print(header)\n",
        "print(\"-\" * len(header))\n",
        "\n",
        "for reg in pasos:\n",
        "    print(f\"{reg['iter']:3d} | {reg['p_n']:14.10f} | {reg['f_pn']:12.4e} | {reg['error']:12.4e}\")\n",
        "\n",
        "print()\n",
        "if exito:\n",
        "    print(f\"Convergencia en {len(pasos)} iteraciones.\")\n",
        "    print(f\"Raíz aproximada = {solucion:.10f}\")\n",
        "else:\n",
        "    print(\"No convergió en el número máximo de iteraciones.\")"
      ],
