        "\n",
        "# Parámetros del problema\n",
        "A_INIT: float = 1.0\n",
        "B_INIT: float = 2.0\n",
        "TOLERANCE: float = 1e-4\n",
        "MAX_ITER: int = 50\n",
        "\n",
        "print(\"Modelo y parámetros cargados correctamente.\")"
      ],
