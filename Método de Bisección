        "def algoritmo_biseccion(\n",
        "    func: Callable[[float], float],\n",
        "    a: float,\n",
        "    b: float,\n",
        "    tol: float,\n",
        "    max_iteraciones: int\n",
        ") -> Tuple[float, pd.DataFrame]:\n",
        "    \"\"\"\n",
        "    Implementación estructurada del Algoritmo 2.1 de Burden & Faires.\n",
        "    \"\"\"\n",
        "    fa = func(a)\n",
        "    if fa * func(b) >= 0:\n",
        "        raise ValueError(\"El intervalo introducido no cumple con el Teorema del Valor Intermedio: f(a)*f(b) >= 0.\")\n",
        "\n",
        "    registros: List[Dict[str, float]] = []\n",
        "    i = 1\n",
        "\n",
        "    while i <= max_iteraciones:\n",
        "        # Paso 3 del algoritmo: punto medio y evaluación\n",
        "        p = a + (b - a) / 2.0\n",
        "        fp = func(p)\n",
        "        error_half_width = (b - a) / 2.0\n",
        "\n",
        "        # Almacenar métricas de la iteración\n",
        "        registros.append({\n",
        "            'Iteración': i,\n",
        "            'a_i': a,\n",
        "            'b_i': b,\n",
        "            'p_i (Aprox)': p,\n",
        "            'f(p_i)': fp,\n",
        "            'Error Abs. (b-a)/2': error_half_width\n",
        "        })\n",
        "\n",
        "        # Paso 4: Criterio de convergencia\n",
        "        if fp == 0 or error_half_width < tol:\n",
        "            df_resultados = pd.DataFrame(registros)\n",
        "            return p, df_resultados\n",
        "\n",
        "        # Pasos 5 y 6: Actualización de subintervalos\n",
        "        i += 1\n",
        "        if fa * fp > 0:\n",
        "            a = p\n",
        "            fa = fp\n",
        "        else:\n",
        "            b = p\n",
        "\n",
        "    raise RuntimeError(f\"Se alcanzó el límite máximo de iteraciones ({max_iteraciones}) sin convergencia.\")"
      ],
