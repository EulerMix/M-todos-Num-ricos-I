        "# Método de diferencias divididas de Newton — Burden, algoritmo 3.2\n",
        "# Ejemplo 1, p. 94\n",
        "\n",
        "from sympy import *\n",
        "from IPython.display import display\n",
        "\n",
        "xi = [1.0, 1.3, 1.6, 1.9, 2.2]\n",
        "a = [0.7651977, 0.6200860, 0.4554022, 0.2818186, 0.1103623]\n",
        "\n",
        "def diferencias_divididas(xi, a):\n",
        "    n = len(xi)\n",
        "    F = [[0.0 for j in range(n)] for i in range(n)]\n",
        "\n",
        "    # Primera columna: F[i][0] = f(xi)\n",
        "    for i in range(n):\n",
        "        F[i][0] = a[i]\n",
        "\n",
        "    # Formula de las diferencias divididas\n",
        "    for i in range(1, n):\n",
        "        for j in range(1, i+1):\n",
        "            F[i][j] = (F[i][j-1] - F[i-1][j-1])/(xi[i] - xi[i-j])\n",
        "\n",
        "    # Tabla de diferencias divididas\n",
        "    print('Tabla de diferencias divididas:')\n",
        "    print(f\"{'i':<4}{'xi':<8}\" + ''.join(f\"{'F'+str(j):>13}\" for j in range(n)))\n",
        "    for i in range(n):\n",
        "        fila = f\"{i:<4}{xi[i]:<8.1f}\"\n",
        "        for j in range(n):\n",
        "            if j <= i:\n",
        "                fila = fila + f\"{F[i][j]:>13.7f}\"\n",
        "        print(fila)\n",
        "\n",
        "    # Coeficientes de la diagonal\n",
        "    coef = []\n",
        "    for i in range(n):\n",
        "        coef.append(F[i][i])\n",
        "\n",
        "    return coef\n",
        "\n",
        "coef = diferencias_divididas(xi, a)\n",
        "\n",
        "for i in range(len(coef)):\n",
        "    print(f\"a{i} = {coef[i]:.7f}\")\n",
        "\n",
        "def escribir_y_graficar(coef, xi):\n",
        "    x = symbols('x')\n",
        "    p = 0\n",
        "\n",
        "    for k in range(len(coef)):\n",
        "        termino = coef[k]\n",
        "        for j in range(k):\n",
        "            termino = termino*(x-xi[j])\n",
        "        p = p + termino\n",
        "\n",
        "    print('Polinomio de Newton:')\n",
        "    display(p)\n",
        "\n",
        "    print('Polinomio desarrollado:')\n",
        "    display(expand(p))\n",
        "\n",
        "    print('Grafica del polinomio:')\n",
        "    plotting.plot(p, (x, xi[0], xi[-1]),\n",
        "                  title='Interpolacion de Newton',\n",
        "                  xlabel='x', ylabel='P4(x)',\n",
        "                  line_color='blue')\n",
        "\n",
        "    return p\n",
        "\n",
        "p = escribir_y_graficar(coef, xi)\n",
        "\n",
        "x = symbols('x')\n",
        "valor = p.subs(x, 1.5)\n",
        "print(f\"P4(1.5) = {float(valor):.7f}\")\n",
        "\n",
        "print(f\"{'xi':>5} {'f(xi)':>12} {'P4(xi)':>12}\")\n",
        "for i in range(len(xi)):\n",
        "    print(f\"{xi[i]:>5.1f} {a[i]:>12.7f} {float(p.subs(x,xi[i])):>12.7f}\")\n"
      ]
